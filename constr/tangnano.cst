// Tang Nano 9K pin constraints — GW1NR-LV9QN88PC6/I5
//
// Pin numbering: QFN88 physical package pin numbers (1–88).
//
// UART NOTE — pins 17 & 18 are NOT on the GPIO header.
// They are QFN88 package pins routed internally to the BL702 USB-UART bridge.
// The BL702 forwards them to the USB-C connector as a virtual serial port.
// Use these for debug console output; access via any serial terminal at 115200.
//
// For Phase 2 (AT-command protocol to ESP32-S3), add a second UART module and
// constrain it to header-accessible pins — see uart_ext_tx/uart_ext_rx below.

IO_LOC "sys_clk"   52;
IO_PORT "sys_clk"  PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC "sys_rst_n" 4;
IO_PORT "sys_rst_n" PULL_MODE=UP IO_TYPE=LVCMOS18;

// Primary UART — routes to BL702 USB-UART bridge (USB-C serial, NOT GPIO header)
IO_LOC "uart_rx"   18;
IO_PORT "uart_rx"  PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "uart_tx"   17;
IO_PORT "uart_tx"  PULL_MODE=UP IO_TYPE=LVCMOS33;

// Phase 2 — Secondary UART for ESP32-S3 host connection (header-accessible pins)
// Wiring: ESP32-S3 GPIO16 (TX) → Tang header pin 39 (uart_ext_rx)
//         ESP32-S3 GPIO17 (RX) ← Tang header pin 38 (uart_ext_tx)
//         GND shared (3.3 V logic, no level shifting needed)
// Uncomment when the Phase 2 UART module is instantiated in top.v:
// IO_LOC "uart_ext_tx"  38;
// IO_PORT "uart_ext_tx" PULL_MODE=NONE IO_TYPE=LVCMOS33;
// IO_LOC "uart_ext_rx"  39;
// IO_PORT "uart_ext_rx" PULL_MODE=UP   IO_TYPE=LVCMOS33;
IO_LOC "led[0]"    10;
IO_LOC "led[1]"    11;
IO_LOC "led[2]"    13;
IO_LOC "led[3]"    14;
IO_LOC "led[4]"    15;
IO_LOC "led[5]"    16;
IO_PORT "led[0]"   IO_TYPE=LVCMOS18;
IO_PORT "led[1]"   IO_TYPE=LVCMOS18;
IO_PORT "led[2]"   IO_TYPE=LVCMOS18;
IO_PORT "led[3]"   IO_TYPE=LVCMOS18;
IO_PORT "led[4]"   IO_TYPE=LVCMOS18;
IO_PORT "led[5]"   IO_TYPE=LVCMOS18;
